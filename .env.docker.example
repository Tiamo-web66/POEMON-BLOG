# Copy this file to .env before running docker compose.
# PowerShell: Copy-Item .env.docker.example .env
# Bash: cp .env.docker.example .env

# Prebuilt images. Override these only if you publish images under another registry/name.
BACKEND_IMAGE=ghcr.io/tiamo-web66/tiamo-blog-backend:latest
FRONTEND_IMAGE=ghcr.io/tiamo-web66/tiamo-blog-frontend:latest

# Public HTTP port for the Vue/Nginx container.
# If port 80 is occupied, change it to 8088 and visit http://localhost:8088.
FRONTEND_PORT=8088

# Site URLs baked into the Vue static bundle at image build time.
# The default image uses same-origin /api, so no rebuild is needed for normal reverse proxy deployment.
VITE_API_BASE_URL=/api
VITE_WEB_URL=http://localhost:8088
VITE_SITE_URL=http://localhost:8088

# MySQL container settings.
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_APP_USER=blog
MYSQL_APP_PASSWORD=change_this_app_password
DB_NAME=myblog

# Backend security settings.
# Generate a strong value before production deployment: openssl rand -base64 32
JWT_SECRET=change_this_jwt_secret
ENVIRONMENT=production

# Site metadata used by backend emails and links.
SITE_NAME=TiAmo-Blog
SITE_URL=http://localhost:8088
BOSS_WECHAT=
EMAIL_HEADER_IMAGE=

# Allowed browser origins for direct API access.
# Same-origin /api access through Nginx does not normally need CORS.
CORS_ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088

# Email settings. Leave empty if unused.
EMAIL_FROM=
EMAIL_PASSWORD=
EMAIL_SMTP_HOST=smtp.qq.com
EMAIL_SMTP_PORT=465

# AI summary service settings. Leave empty if unused.
AI_API_KEY=
AI_API_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# Weather API settings. Leave empty if unused.
WEATHER_API_ID=
WEATHER_API_KEY=

# Backend defaults.
DEFAULT_SORT_ID=11
DEFAULT_LABEL_ID=23
MAX_USERNAME_LENGTH=50
MAX_PASSWORD_LENGTH=128
MIN_PASSWORD_LENGTH=6
MAX_ARTICLE_TITLE_LENGTH=200
MAX_COMMENT_LENGTH=2000
MAX_TREEHOLE_LENGTH=500
DB_LOG_SQL=false
TZ=Asia/Shanghai
