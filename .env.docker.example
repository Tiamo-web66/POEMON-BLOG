# Copy this file to .env before running docker compose.
# PowerShell: Copy-Item .env.docker.example .env
# Bash: cp .env.docker.example .env

# Public HTTP port for the Vue/Nginx container.
# If port 80 is occupied, change it to 8080 and visit http://localhost:8080.
FRONTEND_PORT=80

# Site URLs baked into the Vue static bundle at build time.
# Use your real domain in production, for example https://blog.example.com.
VITE_API_BASE_URL=/api
VITE_WEB_URL=http://localhost
VITE_SITE_URL=http://localhost

# MySQL container settings.
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_APP_USER=blog
MYSQL_APP_PASSWORD=change_this_blog_password
DB_NAME=myblog

# Backend security settings.
# Generate a strong value before production deployment.
JWT_SECRET=change_this_jwt_secret
ENVIRONMENT=production

# Site metadata used by backend emails and links.
SITE_NAME=My-Blog
SITE_URL=http://localhost
BOSS_WECHAT=
EMAIL_HEADER_IMAGE=

# Allowed browser origins for direct API access.
# Same-origin /api access through Nginx does not normally need CORS.
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1

# Email settings.
EMAIL_FROM=
EMAIL_PASSWORD=
EMAIL_SMTP_HOST=smtp.qq.com
EMAIL_SMTP_PORT=465

# AI summary service settings.
AI_API_KEY=
AI_API_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# Weather API settings.
WEATHER_API_ID=
WEATHER_API_KEY=

# Backend defaults.
DEFAULT_SORT_ID=11
DEFAULT_LABEL_ID=23
MAX_USERNAME_LENGTH=50
MAX_PASSWORD_LENGTH=128
MIN_PASSWORD_LENGTH=6
MAX_ARTICLE_TITLE_LENGTH=200
MAX_COMMENT_LENGTH=2000
MAX_TREEHOLE_LENGTH=500
DB_LOG_SQL=false
TZ=Asia/Shanghai

